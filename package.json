{
  "name": "photographer-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "摄影师 AI 接单跟单助手 — 三端单仓（Web / RN App / Taro 小程序 + 共享包）。后端 photographer-ai-backend 为兄弟目录，不属于本 workspace。",
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^1.13.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "webpack": "5.78.0",
      "react": "18.3.1",
      "@tanstack/react-query": "5.101.4",
      "@tanstack/query-core": "5.101.4",
      "zustand": "4.5.7",
      "axios": "1.19.0"
    }
  }
}
